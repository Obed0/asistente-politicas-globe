[Unit]
Description=Asistente RAG de Politicas Internas - Globex Corp (Streamlit)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/asistente-politicas-globex
EnvironmentFile=/home/ubuntu/asistente-politicas-globex/.env
ExecStart=/home/ubuntu/asistente-politicas-globex/venv/bin/streamlit run app.py --server.port=8501 --server.address=0.0.0.0 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
